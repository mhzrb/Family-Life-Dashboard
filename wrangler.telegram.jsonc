{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-life-telegram",
  "main": "telegram-worker.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
