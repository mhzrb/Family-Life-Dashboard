{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-life-dashboard",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "TELEGRAM_WEBHOOK_URL": "https://family-life-telegram.mhmd-zarabieh.workers.dev/telegram",
  },
  "secrets": {
    "required": [
      "POLICY_AUD",
      "TEAM_DOMAIN",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_WEBHOOK_SECRET",
    ],
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-life-dashboard",
      "database_id": "92b01fbd-e3e5-45e9-a324-ad34bb620d8e",
      "migrations_dir": "drizzle",
    },
  ],
}
